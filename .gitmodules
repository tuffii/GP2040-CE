[submodule "lib/tinyusb"]
	path = lib/tinyusb
	url = https://github.com/OpenStickCommunity/tinyusb.git
[submodule "lib/pico_pio_usb"]
	path = lib/pico_pio_usb
	url = https://github.com/OpenStickCommunity/Pico-PIO-USB.git
	branch = dev
[submodule "lib/pico-sdk"]
	path = lib/pico-sdk
	url = https://github.com/raspberrypi/pico-sdk.git
	branch = 2.1.1
